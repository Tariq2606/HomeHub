<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to talk to the cloud (Tuya) and to devices on the local network (CozyLife) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Needed to receive UDP broadcast replies during CozyLife device discovery -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Needed to show low-power / threshold alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed for exact-time on/off schedules -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".HomeHubApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeHub"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic is required because CozyLife devices are controlled
          over plain (unencrypted) local TCP/UDP on your own WiFi network, not HTTPS.
          Tuya cloud calls still go over HTTPS regardless.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HomeHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".scheduling.ScheduleAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".scheduling.BootRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
